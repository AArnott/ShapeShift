<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PublishNativeAOTTests>false</PublishNativeAOTTests>

    <!--
      The Roslyn workspace host used by the code fix tests relies on MEF composition,
      so this test project is deliberately excluded from the NativeAOT test matrix.
    -->
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ShapeShift\ShapeShift.csproj" />
    <ProjectReference Include="..\..\src\ShapeShift.Json\ShapeShift.Json.csproj" />
    <ProjectReference Include="..\..\src\ShapeShift.Analyzers\ShapeShift.Analyzers.csproj" />
    <ProjectReference Include="..\..\src\ShapeShift.Analyzers.CodeFixes\ShapeShift.Analyzers.CodeFixes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="PolyType" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <!--
    The .NET 11 SDK restores the net10.0 targeting pack into the NuGet cache instead of
    packs/Microsoft.NETCore.App.Ref. Record that restored path so the harness compiles
    against reference assemblies rather than the shared-framework runtime.
    AssemblyMetadata is the SDK extension point hashed into the generated assembly info,
    so a changed pack path rebuilds the test assembly.
  -->
  <Target Name="AddNetCoreReferencePackMetadata" BeforeTargets="GetAssemblyAttributes" DependsOnTargets="ResolveFrameworkReferences">
    <ItemGroup>
      <AssemblyMetadata Include="Microsoft.NETCore.App.Ref" Condition="'%(ResolvedFrameworkReference.Identity)' == 'Microsoft.NETCore.App' and '%(ResolvedFrameworkReference.TargetingPackPath)' != ''">
        <Value>%(ResolvedFrameworkReference.TargetingPackPath)</Value>
      </AssemblyMetadata>
    </ItemGroup>
  </Target>

  <Target Name="PackShapeShiftForAnalyzerTests" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <AnalyzerPackageTestOutput>$(BaseIntermediateOutputPath)package-under-test\</AnalyzerPackageTestOutput>
    </PropertyGroup>
    <MSBuild
      Projects="..\..\src\ShapeShift\ShapeShift.csproj"
      Targets="Pack"
      BuildInParallel="false"
      Properties="Configuration=$(Configuration);BuildProjectReferences=false;PackageOutputPath=$(AnalyzerPackageTestOutput)" />
  </Target>

</Project>
